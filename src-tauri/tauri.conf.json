{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biblioteca 3D",
  "version": "0.1.8",
  "identifier": "com.biblioteca3d.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Biblioteca 3D",
        "width": 1420,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQTdDRTQyMENCQTNCRjMKUldUek83b01RczZuMFBwUkVQY0tEWDdNbDBSR3ZORlNLYU8rRGs5U0lLUHZrR1cyOHM2MEdDcmMK",
      "endpoints": [
        "https://github.com/Lucasleiva1/bliblioteca-3d/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
