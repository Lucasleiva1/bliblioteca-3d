{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biblioteca 3D",
  "version": "0.1.0",
  "identifier": "com.biblioteca3d.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Biblioteca 3D",
        "width": 1420,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
